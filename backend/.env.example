PORT=5000
# Local MongoDB (default for development):
MONGO_URI=mongodb://127.0.0.1:27017/flowsense
# Atlas MongoDB (replace with your connection string):
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/flowsense
JWT_SECRET=replace_with_strong_secret

# Email OTP Gateway (configure at least ONE option below, or configure via Admin Console -> Email OTP Gateway):
# Option 1 (Recommended for cloud/Render - free 300/day via HTTPS):
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=your-verified-sender@gmail.com
# Option 2 (Gmail Apps Script HTTPS Webhook - 100% free via Gmail):
# EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# Option 3 (Gmail SMTP with 16-char Google App Password):
# EMAIL_USER=yourname@gmail.com
# EMAIL_PASS=abcd efgh ijkl mnop
# Option 4 (Resend HTTPS API):
# RESEND_API_KEY=re_...
